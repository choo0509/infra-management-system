# Copy this file to .env and replace values where needed.
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data

# Leave these empty for plain HTTP. See README.md for certificate setup.
SSL_PFX_FILE=
SSL_PFX_PASSPHRASE=
# Or use PEM files instead:
# SSL_CERT_FILE=
# SSL_KEY_FILE=

COOKIE_SECURE=auto
SESSION_HOURS=8
TRUST_PROXY=0
JWT_SECRET=

# Optional PostgreSQL connection. Leave empty to use SQLite.
DATABASE_URL=
DATABASE_SSL=false

# Optional OpenAI-compatible assistant endpoint.
KIMI_URL=
KIMI_MODEL=
KIMI_CA_CERT_PATH=
KIMI_API_KEY=
